{
  "name": "tapi-batch-system",
  "version": "1.0.0",
  "description": "AWS Batch Processing System for Tapi — processes 1M daily records via distributed EventBridge Schedules, SQS, and Lambda",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'infrastructure/**/*.ts' --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "LOCALSTACK=true vitest run --reporter=verbose",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff --all",
    "cdk:deploy:qa": "cdk deploy --all --context environment=qa --require-approval never",
    "cdk:deploy:prod": "cdk deploy --all --context environment=prod"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-scheduler": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.600.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.14.0",
    "@typescript-eslint/parser": "^7.14.0",
    "aws-cdk": "^2.149.0",
    "aws-cdk-lib": "^2.149.0",
    "constructs": "^10.3.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
